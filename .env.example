# ==============================================================================
# KS Digital - Environment Configuration
# ==============================================================================

# MySQL database connection
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Auth session secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# Initial super admin credentials (required by prisma/seed.ts)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-strong-password"
ADMIN_NAME="Site Administrator"

# Email integration (optional; lead submissions are saved without it)
RESEND_API_KEY=""
NOTIFICATION_EMAIL="admin@example.com"
FROM_EMAIL="onboarding@resend.dev"

# Image upload storage (optional)
BLOB_READ_WRITE_TOKEN=""

# Public website URL for canonical SEO tags
NEXT_PUBLIC_SITE_URL="https://example.com"
